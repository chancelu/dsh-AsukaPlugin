{
  "name": "@local/eva-unit-02",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "EVA Unit-02 / Asuka Langley Soryu skin for the Harness Web UI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chancelu/dsh-AsukaPlugin.git"
  },
  "homepage": "https://github.com/chancelu/dsh-AsukaPlugin",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "evangelion",
    "asuka",
    "theme",
    "skin"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
